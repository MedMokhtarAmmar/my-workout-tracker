# Copy this file to .env and fill in your own values. See README.md for the
# step-by-step Google Cloud Console setup.

# From Google Cloud Console > APIs & Services > Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Must exactly match an "Authorized redirect URI" on that OAuth client.
# Local dev: http://localhost:3000/auth/google/callback
# Behind Caddy on a real domain: https://your-domain/auth/google/callback
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# Any Google account can sign in/sign up now — this is only used once, the
# very first time the app starts against a pre-multi-user database, to
# assign your existing data (sessions, body stats, settings, etc.) to your
# account instead of leaving it unowned. Safe to remove after that.
OWNER_EMAIL=you@gmail.com

# Any long random string — used to sign the login session cookie
SESSION_SECRET=change-me-to-a-random-string
